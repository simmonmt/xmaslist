#!/bin/bash
#
# Runs docker compose for the dev stack: the image (--tag, default latest) on
# --port (default 8080), using the given database file and the dev session secret. Compose arguments follow the options, e.g.
#   docker/docker-compose-dev --db=dev.sqlite up -d
# A `--` before them (needed for compose options that precede the command) is
# also accepted.

set -e

function die {
    echo "${PROGNAME}:" "$@" >&2
    exit 1
}

function usage {
    echo "Usage: ${PROGNAME} --db=db_file [--tag=tag] [--port=port] [--] compose_args..." >&2
    exit 2
}

PROGNAME=$(basename "$0")
PROGDIR=$(dirname "$0")

# GNU getopt is required (for long options). macOS's isn't; use Homebrew's
# gnu-getopt if it's installed.
GETOPT=getopt
if command -v brew >/dev/null 2>&1 ; then
    prefix=$(brew --prefix --installed gnu-getopt 2>/dev/null) || true
    if [[ -n "${prefix}" ]] ; then
	GETOPT="${prefix}/bin/getopt"
    fi
fi
# GNU getopt's -T (test) exits with 4.
getopt_status=0
"${GETOPT}" -T >/dev/null 2>&1 || getopt_status=$?
[[ "${getopt_status}" -eq 4 ]] || \
    die "GNU getopt required; on macOS: brew install gnu-getopt"

tag=latest
port=8080

# The leading + stops option parsing at the first non-option (the compose
# command), so compose arguments don't need a `--`.
options=$("${GETOPT}" -o '+' --longoptions db:,port:,tag: -- "$@") || usage
eval set -- "$options"
while : ; do
    case "$1" in
        --db)
            db="$2"
            shift 2
            ;;
        --port)
            port="$2"
            shift 2
            ;;
        --tag)
            tag="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *)
            usage
            ;;
    esac
done

[[ -z "${db}" ]] && usage
[[ -f "${db}" ]] || die "${db}: no such file"
[[ "${port}" =~ ^[0-9]+$ ]] || die "${port}: bad port"

# Compose resolves relative bind paths against the project directory
# (docker/), so pass an absolute path.
dbdir=$(CDPATH='' cd -- "$(dirname -- "${db}")" && pwd)
XMASLIST_DATABASE="${dbdir}/$(basename -- "${db}")"
export XMASLIST_DATABASE

export CONTAINER_TAG="${tag}"
export XMASLIST_PORT="${port}"
export CONTAINER_PREFIX=xmaslist_dev

docker compose \
  --project-directory "${PROGDIR}" \
  --project-name xmaslist_dev \
  -f "${PROGDIR}/base.yml" \
  -f "${PROGDIR}/dev.yml" \
  "$@"
