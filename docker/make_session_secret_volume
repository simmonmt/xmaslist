#!/bin/bash
#
# Creates the xmaslist_session_secret volume if it doesn't exist, writes a new
# random session secret to session_secret.txt in it (replacing any existing
# one), and prints the secret. The secret is generated inside an alpine
# container, so the host needs only docker.

set -e

function die {
    echo "${PROGNAME}:" "$@" >&2
    exit 1
}

function usage {
    echo "Usage: ${PROGNAME}" >&2
    exit 2
}

PROGNAME=$(basename "$0")

[[ $# -eq 0 ]] || usage

VOL=xmaslist_session_secret

docker volume create ${VOL}

docker run --rm --name ${VOL}_create -v ${VOL}:/vol alpine sh -c \
       'set -eo pipefail
        head -c 4096 /dev/urandom | sha256sum | cut -d" " -f1 \
            >/vol/session_secret.txt'

docker run --rm --name ${VOL}_verify -v ${VOL}:/vol alpine sh -c \
       'test -s /vol/session_secret.txt && cat /vol/session_secret.txt' || \
    die "failed to write the session secret"
