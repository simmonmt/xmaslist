#!/bin/bash

set -e

function die {
    echo "${PROGNAME}:" "$@" >&2
    exit 1
}

function usage {
    echo "Usage: ${PROGNAME} [--vol volname] outfile" >&2
    exit 2
}

PROGNAME=$(basename "$0")

GETOPT=getopt
if which brew >/dev/null 2>&1 ; then
    prefix=$(brew --prefix gnu-getopt 2>/dev/null)
    if [[ -n "${prefix}" ]] ; then
        GETOPT="${prefix}/bin/getopt"
    fi
fi

VOL=xmaslist_database
options=$(${GETOPT} -o '' --longoptions vol: -- "$@")
[[ $? -ne 0 ]] && usage
eval set -- "$options"
while : ; do
    case "$1" in
        --vol)
           VOL="$2"
	   shift 
           ;;
        --)
           shift
           break
           ;;
    esac
    shift
done

[[ $# -ne 1 ]] && usage
OUTFILE="${1}"

CONTAINER=xmaslist_database_copy
docker container create \
       --name "${CONTAINER}" \
       -v ${VOL}:/db \
       alpine
docker cp "${CONTAINER}":/db/db.sqlite "${OUTFILE}"

docker container rm "${CONTAINER}"
