#!/bin/bash

set -e

function die {
    echo "${PROGNAME}:" "$@" >&2
    exit 1
}

function usage {
    echo "Usage: ${PROGNAME} [--load_test_data] [--rm] [--vol volname]" >&2
    echo "       ${PROGNAME} [--load_test_data] --local path" >&2
    exit 2
}

PROGNAME=$(basename "$0")

# GNU getopt is required (for long options). macOS's isn't; use Homebrew's
# gnu-getopt if it's installed.
GETOPT=getopt
if command -v brew >/dev/null 2>&1 ; then
    prefix=$(brew --prefix --installed gnu-getopt 2>/dev/null) || true
    if [[ -n "${prefix}" ]] ; then
	GETOPT="${prefix}/bin/getopt"
    fi
fi
# GNU getopt's -T (test) exits with 4.
getopt_status=0
"${GETOPT}" -T >/dev/null 2>&1 || getopt_status=$?
[[ "${getopt_status}" -eq 4 ]] || \
    die "GNU getopt required; on macOS: brew install gnu-getopt"

VOL=xmaslist_database
options=$(${GETOPT} -o '' --longoptions help,load_test_data,local:,rm,vol: -- "$@")
[[ $? -ne 0 ]] && usage
eval set -- "$options"
while : ; do
    case "$1" in
	--help)
	    usage
	    ;;
        --load_test_data)
            LOADTESTDATA=1
            ;;
	--local)
	    LOCAL="$2"
	    shift
	    ;;
        --rm)
            RMVOL=1
            ;;
	--vol)
	    VOL="$2"
	    VOL_SET=1
	    shift
	    ;;
        --)
            shift
            break
            ;;
    esac
    shift
done

[[ $# -ne 0 ]] && usage

if [[ -n "${LOCAL}" ]] ; then
    [[ "${RMVOL}" -eq 1 || "${VOL_SET}" -eq 1 ]] && \
	die "--local can't be used with --rm or --vol"
    # Absolute, since we cd to the repo root below.
    [[ "${LOCAL}" = /* ]] || LOCAL="${PWD}/${LOCAL}"
elif docker volume inspect ${VOL} >/dev/null 2>&1 ; then
    [[ "$RMVOL" -ne 1 ]] && die "${VOL} exists"
    echo "Removing existing volume ${VOL}"
    docker volume rm ${VOL}
fi

# The paths below are relative to the repo root.
cd "$(dirname "$0")/.."

WORKDIR=$(mktemp -d)
trap 'rm -rf "${WORKDIR}"' EXIT INT QUIT TERM
DB_TMPFILE="${WORKDIR}/db.sqlite"

sqlite3 "${DB_TMPFILE}" <db/schema/schema.txt
if [[ "${LOADTESTDATA}" -eq 1 ]] ; then
    DB_UTIL="${WORKDIR}/db_util"
    go build -o "${DB_UTIL}" ./cmd/db_util

    "${DB_UTIL}" load --spec db/test_data.yaml "${DB_TMPFILE}"
    "${DB_UTIL}" user list "${DB_TMPFILE}"
    "${DB_UTIL}" list list "${DB_TMPFILE}"
fi

if [[ -n "${LOCAL}" ]] ; then
    mv "${DB_TMPFILE}" "${LOCAL}"
    echo "Created ${LOCAL}"
    exit 0
fi

docker volume create ${VOL}
docker container create \
       --name xmaslist_database_create \
       -v ${VOL}:/db \
       alpine
docker cp "${DB_TMPFILE}" xmaslist_database_create:/db

docker container rm xmaslist_database_create
