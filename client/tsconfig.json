{
   "compilerOptions" : {
      "target" : "es2020",
      "lib" : [
         "es2020",
         "dom",
         "dom.iterable"
      ],
      "module" : "esnext",
      "moduleResolution" : "bundler",
      "jsx" : "react",
      // Vite transpiles each file on its own (esbuild/oxc); tsc only checks.
      "isolatedModules" : true,
      "noEmit" : true,
      // "traceResolution" : true,
      "strict" : true,
      // Browser code: do not pull in @types/node (or other global types).
      "types" : []
   },
   "include" : [
      "*.tsx",
      "*.ts"
   ]
}
